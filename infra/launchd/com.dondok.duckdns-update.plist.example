<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.dondok.duckdns-update</string>

  <key>ProgramArguments</key>
  <array>
    <string>__DONDOK_REPOSITORY__/infra/duckdns-update.sh</string>
    <string>--secret-file</string>
    <string>__DONDOK_DUCKDNS_SECRET_FILE__</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>Umask</key>
  <integer>63</integer>

  <key>WorkingDirectory</key>
  <string>__DONDOK_REPOSITORY__</string>

  <key>StartInterval</key>
  <integer>300</integer>
  <key>RunAtLoad</key>
  <true/>

  <key>ProcessType</key>
  <string>Background</string>

  <key>StandardOutPath</key>
  <string>__DONDOK_LOG_DIR__/duckdns-update.log</string>
  <key>StandardErrorPath</key>
  <string>__DONDOK_LOG_DIR__/duckdns-update-error.log</string>
</dict>
</plist>
