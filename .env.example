# Copy this file to .env. Never put a real password or secret in this example.
COMPOSE_PROJECT_NAME=dondok
TZ=Asia/Seoul

POSTGRES_DB=dondok
POSTGRES_USER=dondok
POSTGRES_PASSWORD=CHANGE_ME

DONDOK_PUBLIC_URL=https://money.example.com
DONDOK_COOKIE_SECURE=true
# Public legal contact displayed in terms/privacy. Set the user-approved values on the host.
DONDOK_LEGAL_OPERATOR_NAME=CHANGE_ME
DONDOK_LEGAL_CONTACT_EMAIL=admin@example.com
DONDOK_FRONTEND_PORT=18080
DONDOK_DB_BIND_HOST=127.0.0.1
DONDOK_DB_HOST_PORT=15432

DONDOK_MAIL_ENABLED=true
DONDOK_MAIL_FROM=no-reply@money.example.com
DONDOK_SMTP_HOST=smtp.resend.com
DONDOK_SMTP_PORT=587
DONDOK_SMTP_USERNAME=resend
# Resend API key restricted to sending from the verified domain.
DONDOK_SMTP_PASSWORD=CHANGE_ME
DONDOK_SMTP_AUTH=true
DONDOK_SMTP_STARTTLS=true

# VITE_* values are compiled into the browser bundle and must never be secrets.
# VITE_* values are intentionally unnecessary while UI and API share one origin.

# Optional Vite-only setting in frontend/.env.local (not compiled into the client):
# DONDOK_DEV_API_TARGET=http://127.0.0.1:8082

# CI/deployment-only settings (provided by the workflow/process, not Compose .env):
# E2E_SCOPE=pr|full|benchmark, E2E_WORKERS=1|2|3
# E2E_AFFECTED_PATTERN is produced from the PR diff; absence selects all tests.
# PR_BASE_SHA is the PR base commit used by the affected-test selector.
# GH_TOKEN: Actions artifact read credential; keep it in the host secret store.
# DONDOK_BACKEND_IMAGE / DONDOK_FRONTEND_IMAGE: approved GHCR digest references.
# Deployment resolves these from release.json; do not set mutable tags here.
