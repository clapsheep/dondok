# Copy this file to .env. Never put a real password or secret in this example.
COMPOSE_PROJECT_NAME=dondok
TZ=Asia/Seoul

POSTGRES_DB=dondok
POSTGRES_USER=dondok
POSTGRES_PASSWORD=CHANGE_ME

DONDOK_PUBLIC_URL=https://money.example.com
DONDOK_COOKIE_SECURE=true
DONDOK_FRONTEND_PORT=18080
DONDOK_DB_BIND_HOST=127.0.0.1
DONDOK_DB_HOST_PORT=15432

DONDOK_MAIL_ENABLED=true
DONDOK_MAIL_FROM=no-reply@money.example.com
DONDOK_SMTP_HOST=smtp.example.com
DONDOK_SMTP_PORT=587
DONDOK_SMTP_USERNAME=CHANGE_ME
DONDOK_SMTP_PASSWORD=CHANGE_ME
DONDOK_SMTP_AUTH=true
DONDOK_SMTP_STARTTLS=true

# VITE_* values are compiled into the browser bundle and must never be secrets.
# VITE_* values are intentionally unnecessary while UI and API share one origin.
